# Copy to .env (Bun loads it automatically). Keys stay server-side.
# Provider auto-detect order: PROVIDER, then ANTHROPIC key, then XAI key, then a reachable Ollama.

# Full experience: lead agent + 4 specialists, web search/fetch, code sandbox.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # lead agent effort: low | medium | high | xhigh | max
# WEB_SEARCH=1                  # set 0 to disable the researcher's web tools

# Solo mode (single agent, no sub-agents):
# XAI_API_KEY=
# XAI_MODEL=grok-4.7
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# PROVIDER=anthropic            # force one of: anthropic | xai | ollama
# PORT=8787
# HOST=127.0.0.1                # 0.0.0.0 only behind your own auth
